# NOT INSTALLED as of 2.0.0~alpha-4. The package now ships the user unit in
# packaging/systemd/user/ instead: the application runs in the user's own
# session, as the user, with no root anywhere in the path. This file is kept in
# the source tree because it is the only written record of what the root
# service did and why, and because a machine that wants one always-on shared
# queue rather than a per-login one can still install it by hand. Nothing in
# scripts/build-deb.sh or the maintainer scripts references it any more; if it
# is installed by hand it must not run at the same time as a user service,
# because both bind port 8631.
#
[Unit]
Description=Samsung ML-216x Printer Application
Documentation=https://github.com/caganerg/ml216x-printer-app
# Avahi is what publishes the printer over DNS-SD. It is a Recommends, not a
# Depends: without it the application still serves IPP on the network interfaces,
# it simply is not advertised.
After=network.target avahi-daemon.service
Wants=avahi-daemon.service

[Service]
Type=simple
ExecStart=/usr/bin/ml216x-printer-app --spool-directory /var/spool/ml216x-printer-app server
Restart=on-failure
RestartSec=5

# Runs as root, deliberately and narrowly: PAPPL puts a root server's state in
# /var/lib/ml216x-printer-app.state and its control socket in
# /run/ml216x-printer-app.sock, and opening a usb:// device means opening a
# node under /dev/bus/usb. A dedicated user plus a udev rule is the better
# shape and is deferred to hardware bring-up, because the rule needs the
# printer's real USB vendor and product IDs and those have not been read off a
# device yet.
User=root
ProtectHome=yes
# Safe here: the root server's socket lives in /run, not in /tmp, so a private
# /tmp does not hide it from the client subcommands.
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
