#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e

case "$1" in
remove)
    if command -v udevadm >/dev/null 2>&1 && [ -d /run/udev ]; then
        udevadm control --reload-rules || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
    ;;

purge)
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
    # The only state this package can still own is what the root service of
    # 2.0.0~alpha-3 and earlier left behind. A user service keeps its printers
    # in each user's own $XDG_CONFIG_HOME/ml216x-printer-app.state and its
    # spool in that user's runtime directory; purging a package is not licence
    # to delete files out of people's home directories, so neither is touched.
    # The README says how to remove them.
    rm -f /var/lib/ml216x-printer-app.state
    rm -rf /var/spool/ml216x-printer-app
    ;;

upgrade | failed-upgrade | abort-install | abort-upgrade | disappear) ;;

*)
    echo "postrm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
