#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e

case "$1" in
remove | deconfigure)
    if [ -d /run/systemd/system ]; then
        systemctl stop ml216x-printer-app.service || true
    fi
    ;;

# Not on upgrade: postinst restarts the service, so stopping it here would only
# widen the window in which no server is listening.
upgrade | failed-upgrade) ;;

*)
    echo "prerm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
