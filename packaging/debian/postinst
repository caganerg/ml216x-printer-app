#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e

UNIT=ml216x-printer-app.service

case "$1" in
configure)
    # Up to and including 2.0.0~alpha-3 — under the old package name
    # samsung-ml2160-rust — this installed a system unit that ran the
    # application as root. A root server holding port 8631 would keep the user
    # service from ever binding, so it has to be gone before this one starts.
    #
    # Two paths lead here and both are covered. An upgrade under this package
    # name is caught by the version test. The rename is not: $2 is empty on the
    # first install of ml216x-printer-app, and the transition is handled instead
    # by apt removing the conflicting old package, whose own prerm and postrm
    # stop and disable that service. What is left after either path is a
    # *dangling* enablement symlink, whose unit file is gone — that is
    # unambiguously the old package's leftover, and never a system unit someone
    # installed by hand, which resolves to a real file and is left alone.
    WANTS="/etc/systemd/system/multi-user.target.wants/$UNIT"
    if { [ -n "$2" ] && dpkg --compare-versions "$2" lt "2.0.0~alpha-4"; } ||
        { [ -L "$WANTS" ] && [ ! -e "$WANTS" ]; }; then
        if [ -d /run/systemd/system ]; then
            systemctl stop "$UNIT" || true
            systemctl disable "$UNIT" || true
        fi
        rm -f "$WANTS"
    fi

    # Apply to future hotplug events; never replay events for attached devices.
    if command -v udevadm >/dev/null 2>&1 && [ -d /run/udev ]; then
        udevadm control --reload-rules
    fi

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        # Enable it in every user's `systemd --user` manager, which is all a
        # package can do from here: root cannot start a service inside a
        # session it does not belong to. A new login starts it by itself, and
        # an already open session picks it up with
        # `systemctl --user start ml216x-printer-app`.
        systemctl --global enable "$UNIT" || true
    fi
    ;;

abort-upgrade | abort-remove | abort-deconfigure) ;;

*)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
